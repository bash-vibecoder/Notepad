#include <windows.h>
#include "version.h"
101 ICON "../windows/anotep.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION ANOTEP_VERSION_NUM
PRODUCTVERSION ANOTEP_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "AnoteP contributors\0"
      VALUE "FileDescription", "AnoteP offline editor\0"
      VALUE "FileVersion", ANOTEP_VERSION "\0"
      VALUE "InternalName", "AnoteP\0"
      VALUE "OriginalFilename", "AnoteP.exe\0"
      VALUE "ProductName", "AnoteP\0"
      VALUE "ProductVersion", ANOTEP_VERSION "\0"
      VALUE "LegalCopyright", "AnoteP contributors; MIT license\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
